# 455A - Boredom
  
n = int(input())
a = list(map(int, input().split()))
mx = max(a)
cnt = [0] * (mx + 1)
for x in a:
    cnt[x] += 1
dp = [0] * (mx + 1)
dp[1] = cnt[1]
for x in range(2, mx + 1):
    take = dp[x - 2] + x * cnt[x]
    skip = dp[x - 1]
    dp[x] = max(take, skip)
print(dp[mx])



# 1195C - Basketball Exercise

n = int(input())
a = list(map(int, input().split()))
b = list(map(int, input().split()))
dp = [[0] * n for _ in range(2)]
dp[0][0] = a[0]
dp[1][0] = b[0]
for i in range(1, n):
    dp[0][i] = max(dp[0][i - 1],dp[1][i - 1] + a[i])
    dp[1][i] = max(dp[1][i - 1],dp[0][i - 1] + b[i])
print(max(dp[0][n - 1], dp[1][n - 1]))



# 1097B - Petr and a Combination Lock

n = int(input())
a = []
for _ in range(n):
    a.append(int(input()))
for mask in range(1 << n):
    s = 0
    for i in range(n):
        if mask & (1 << i):
            s += a[i]
        else:
            s -= a[i]
    if s % 360 == 0:
        print("YES")
        break
else:
    print("NO")



# 698A — Vacations

n = int(input())
a = list(map(int, input().split()))
dp = [[0] * 3 for _ in range(n)]
dp[0][0] = 1
dp[0][1] = 0 if a[0] == 1 or a[0] == 3 else 1000
dp[0][2] = 0 if a[0] == 2 or a[0] == 3 else 1000
for i in range(1, n):
    dp[i][0] = min(dp[i-1]) + 1
    if a[i] == 1 or a[i] == 3:
        dp[i][1] = min(dp[i-1][0], dp[i-1][2])
    else:
        dp[i][1] = 1000
    if a[i] == 2 or a[i] == 3:
        dp[i][2] = min(dp[i-1][0], dp[i-1][1])
    else:
        dp[i][2] = 1000
print(min(dp[n-1]))



# 1418C — Mortal Kombat Tower

t = int(input())
for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))
    dp = [[10**9] * 2 for _ in range(n + 1)]
    dp[0][0] = 0
    for i in range(n):
        dp[i + 1][1] = min(dp[i + 1][1], dp[i][0] + a[i])
        if i + 1 < n:
            dp[i + 2][1] = min(dp[i + 2][1], dp[i][0] + a[i] + a[i + 1])
        dp[i + 1][0] = min(dp[i + 1][0], dp[i][1])
        if i + 1 < n:
            dp[i + 2][0] = min(dp[i + 2][0], dp[i][1])
    print(min(dp[n][0], dp[n][1]))
