# 740. delete and earn 
class Solution:
    def deleteAndEarn(self, nums: List[int]) -> int:
        total={}
        for x in nums:
            total[x]=total.get(x,0)+x
        a=0
        b=0
        for x in range(1,max(nums)+1):
            c=max(b,a+total.get(x,0))
            a=b
            b=c
        return b


  # 416. Partition Equal Subset Sum

class Solution:
    def canPartition(self, nums: List[int]) -> bool:
        total=sum(nums)
        if total%2:
            return False
        target=total//2
        dp=[False]*(target+1)
        dp[0]=True
        for num in nums:
            for i in range(target,num-1,-1):
                if dp[i-num]:
                    dp[i]=True
        return dp[target]

  # 494. Target Sum

class Solution:
    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        s=sum(nums)
        to=(s+target)//2
        if s<abs(target) or (s+target)%2:
            return 0
        dp=[0]*(to+1)
        dp[0]=1
        for i in nums:
            for j in range(to,i-1,-1):
                dp[j]+=dp[j-i]
        return dp[to]

983. Minimum Cost For Tickets

class Solution:
    def mincostTickets(self, days: List[int], costs: List[int]) -> int:
        m=days[-1]
        dp=[0]*(m+1)
        j=0
        for i in range(1,m+1):
            if i==days[j]:
                dp[i]=min(dp[i-1]+costs[0],
                          dp[max(0,i-7)]+costs[1],
                          dp[max(0,i-30)]+costs[2])
                j+=1
            else:
                dp[i]=dp[i-1]
        return dp[m]


  # 1049. Last Stone Weight II

class Solution:
    def lastStoneWeightII(self, stones: List[int]) -> int:
        s=sum(stones)
        to=s//2
        dp=[0]*(to+1)
        for x in stones:
            for j in range(to,x-1,-1):
                dp[j]=max(dp[j],dp[j-x]+x)
        return s-2*dp[to]

